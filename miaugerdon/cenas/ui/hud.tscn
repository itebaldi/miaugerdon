[node name="Texto2" type="Label" parent="Raiz/PainelTutorial/Coluna" unique_id=1901429798]
layout_mode = 2
theme_override_colors/font_color = Color(0.93, 0.9, 0.84, 1)
theme_override_font_sizes/font_size = 14
text = "Você é o Caju. O Alfredo vai adotar um cachorro, e você tem um plano.

WASD    andar pela casa
E       segurar para interagir
F       limpar-se (parado) — baixa a suspeita devagar
Q       miar — chama o Alfredo para onde você está
Tab     ver o plano e o que você já conseguiu
"

[node name="Texto" type="Label" parent="Raiz/PainelTutorial/Coluna" unique_id=734503819]
layout_mode = 2
theme_override_colors/font_color = Color(0.93, 0.9, 0.84, 1)
theme_override_font_sizes/font_size = 14
text = "DUAS FORMAS DE PERDER:
· o cronômetro zerar antes de você terminar
· a barra de suspeita encher até o fim

Agir como um gato normal pela casa é o que baixa a suspeita.
Trabalhar no plano com o Alfredo TE VENDO custa muito mais."

